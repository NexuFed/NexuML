{
  "name": "nexuml-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "setup:python": "node scripts/setup-python.mjs",
    "setup:browser": "playwright install chromium --only-shell",
    "predev": "python/.venv/bin/python scripts/extract_cli.py --output .generated/cli.json",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs all",
    "build:versioned": "node scripts/build.mjs versioned",
    "build:changelog": "node scripts/build.mjs changelog",
    "check": "node scripts/check.mjs",
    "typecheck": "astro check",
    "pretypecheck": "python/.venv/bin/python scripts/extract_cli.py --output .generated/cli.json",
    "preview": "node scripts/preview.mjs",
    "test:api": "node tests/api-proof.mjs",
    "test:gates": "node tests/invalid-content.mjs",
    "test:browser": "node tests/with-fixtures.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.6",
    "@mermaid-js/layout-elk": "0.2.3",
    "astro": "7.4.2",
    "astro-mermaid": "2.1.0",
    "mermaid": "11.17.2",
    "starlight-pydocs": "0.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
