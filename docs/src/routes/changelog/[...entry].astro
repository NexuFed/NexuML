---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { changelogRoute, orderedEntries } from '../../changelog.mjs';
import { globalUrl, revision } from '../../../config.mjs';
interface Props { entry: CollectionEntry<'changelog'> }
export async function getStaticPaths() {
  return orderedEntries(await getCollection('changelog')).map(entry => ({ params: { entry: changelogRoute(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const mediaUrl = (src: string) => src.startsWith('/') ? globalUrl(src) : src;
---
<StarlightPage headings={headings} frontmatter={{ title: entry.data.title, description: entry.data.summary,
  editUrl: `https://github.com/NexuFed/NexuML/edit/${revision}/docs/src/content/changelog/${entry.id}.mdx` }}>
  <p><time datetime={entry.data.date}>{entry.data.date}</time> · {entry.data.category}{entry.data.version && ` · ${entry.data.version}`}</p>
  <p>{entry.data.summary}</p>
  {entry.data.media.map(media => media.type === 'image'
    ? <img src={mediaUrl(media.src)} alt={media.alt} loading="lazy" />
    : <figure>
      <video src={mediaUrl(media.src)} aria-label={media.label} controls preload="metadata">
        {media.captions && <track kind="captions" src={mediaUrl(media.captions.src)} srclang={media.captions.lang} label={media.captions.label} default />}
      </video>
      {media.transcript && <figcaption>{media.transcript}</figcaption>}
    </figure>)}
  <Content />
  {entry.data.links.length > 0 && <ul>{entry.data.links.map(link => <li><a href={mediaUrl(link.url)}>{link.label}</a></li>)}</ul>}
  <p><a href={globalUrl('changelog/')}>All updates</a></p>
</StarlightPage>
