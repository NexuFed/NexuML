---
import { mount, version, target, base } from '../../config.mjs';
const page = target === 'versioned' ? Astro.url.pathname.slice(base.length) : '';
---
<docs-version-picker data-mount={mount} data-page={page} data-version={version}>
  <label>Documentation version
    <select aria-label="Documentation version">
      <option value="dev" selected={version === 'dev'}>dev</option>
      <option value="latest">latest stable</option>
    </select>
  </label>
  <a href={`${mount}${version}/`}>Open selected version</a>
  <span role="status" class="version-status"></span>
</docs-version-picker>
<script>
  type Version = { version: string; title: string; aliases: string[] };
  class VersionPicker extends HTMLElement {
    async connectedCallback() {
      const select = this.querySelector('select')!;
      const link = this.querySelector('a')!;
      const status = this.querySelector<HTMLElement>('[role=status]')!;
      const mount = this.dataset.mount!;
      const page = this.dataset.page || '';
      try {
        const [manifest, publication] = await Promise.all([
          fetch(`${mount}versions.json`).then(r => { if (!r.ok) throw Error(); return r.json(); }),
          fetch(`${mount}publication.json`).then(r => { if (!r.ok) throw Error(); return r.json(); }),
        ]);
        const versions: Version[] = manifest.filter((v: Version) => /^(dev|v\d+\.\d+\.\d+)$/.test(v.version));
        const latest = versions.find(v => v.aliases.includes('latest'))?.version;
        select.replaceChildren(...[
          ...(latest ? [{ version: 'latest', title: `latest (${latest})` }] : []), ...versions,
        ].map(v => new Option(v.title, v.version, false, v.version === this.dataset.version)));
        const update = () => {
          const value = select.value;
          const canonical = value === 'latest' ? latest : value;
          const available = publication.versions[canonical!]?.routes.includes(page);
          const destination = available ? page : '';
          link.href = `${mount}${value}/${destination}${available ? location.hash : ''}`;
          link.textContent = `Open ${value}${available ? '' : ' home'}`;
          status.textContent = !available && page ? 'This page is unavailable in that version. Open its home instead.' : '';
        };
        select.addEventListener('change', update);
        update();
      } catch {
        status.textContent = 'Version list unavailable. Use the documentation home links.';
      }
    }
  }
  customElements.define('docs-version-picker', VersionPicker);
</script>
<style>
  docs-version-picker { display: grid; gap: .4rem; margin-block-end: 1.6rem; font-size: var(--sl-text-sm); }
  label { display: grid; gap: .4rem; color: var(--sl-color-gray-2); }
  select { min-height: 44px; width: 100%; padding: .5rem; border: 1px solid var(--sl-color-gray-4); border-radius: .2rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; cursor: pointer; }
  a { padding-block: .3rem; }
  .version-status { color: var(--sl-color-gray-2); font-size: .8rem; }
</style>
