# NEX-233 experiment only. Generated by submit_rul_enhanced_cfc_fd003.py.
# Staged source is an immutable, verified JuiceFS snapshot, not a Git checkout.
apiVersion: batch/v1
kind: Job
metadata:
  name: nexuml-rul-fd003-cfc-six-s__SEED__
  namespace: __NAMESPACE__
  labels:
    kueue.x-k8s.io/queue-name: jobs
    app.kubernetes.io/name: nexuml
    nexuml-study: rul-fd003-cfc-six
    nexuml-seed: "__SEED__"
    nexuml-source-digest: "__SOURCE_SHORT__"
  annotations:
    nexuml.ika.rub.de/source-sha256: "__SOURCE_DIGEST__"
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: nexuml
        nexuml-study: rul-fd003-cfc-six
        nexuml-seed: "__SEED__"
    spec:
      priorityClassName: normal
      restartPolicy: Never
      runtimeClassName: nvidia
      imagePullSecrets:
        - name: regcred
      # The existing NexuML latest image is published for linux/amd64.
      nodeSelector:
        kubernetes.io/arch: amd64
      volumes:
        - name: juicefs
          persistentVolumeClaim:
            claimName: juicefs
        - name: juicefs-prisma
          persistentVolumeClaim:
            claimName: juicefs-prisma
        - name: runtime-venv
          emptyDir: {}
        - name: shared-mem
          emptyDir:
            medium: Memory
            sizeLimit: 4Gi
      containers:
        - name: nexuml
          image: harbor.ika.rub.de/library/nexuml:latest
          imagePullPolicy: IfNotPresent
          workingDir: /tmp
          env:
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: UV_PROJECT_ENVIRONMENT
              value: /tmp/nexuml-job-venv/.venv
            - name: UV_CACHE_DIR
              value: /tmp/nexuml-job-venv/uv-cache
            - name: UV_PYTHON_INSTALL_DIR
              value: /tmp/nexuml-job-venv/uv-python
            - name: UV_LINK_MODE
              value: copy
            # These refer to mountpoints INSIDE the pod, not host paths.
            - name: NEXUML_DATA_ROOT
              value: /mnt/data
            - name: NEXUML_LOGS_ROOT
              value: /mnt/logs
            - name: NEXUML_RUL_CHECKPOINT_ROOT
              value: /mnt/models/rul/checkpoints
          command: ["/bin/bash", "-c"]
          args:
            - |
              set -euo pipefail
              # All source files and the runtime environment are pod-local.
              # Persistent experiment/data mounts remain independent of source.
              test "$(cat /mnt/nexuml-source/NEX233_SOURCE_DIGEST.txt)" = "__SOURCE_DIGEST__"
              mkdir -p /tmp/nexuml-run
              cp -R /mnt/nexuml-source/. /tmp/nexuml-run/
              test ! -e /tmp/nexuml-run/.experiments
              test ! -e /tmp/nexuml-run/data
              ln -s /mnt/nexuml-experiments /tmp/nexuml-run/.experiments
              ln -s /mnt/nexuml-data /tmp/nexuml-run/data
              cd /tmp/nexuml-run
              test "$(cat NEX233_SOURCE_DIGEST.txt)" = "__SOURCE_DIGEST__"
              test -f src/nexuml/cli/main.py
              test -f library/src/nexuml_library/scenarios/maintenance/rul_enhanced_cfc.py
              test -f uv.lock
              # This RUL loader does NOT use NEXUML_RUL_CHECKPOINT_ROOT for
              # discovery. It requires the validated upstream audit manifest,
              # whose best_model_path must exist inside the pod.
              python3 - <<'PY'
              import json
              from pathlib import Path

              run = "rul-FD003-controlled-patchformer-seed42"
              audit = Path(".experiments/rul/audits") / f"{run}.checkpoint.json"
              endpoint = (
                  Path(".experiments/rul/prepared")
                  / "rul-FD003-patchformer-sequence-cfc-flow-seed42-endpoints.pt"
              )
              if not audit.is_file():
                  raise SystemExit(
                      f"Missing upstream PatchFormer audit: {audit}. "
                      "The mounted /mnt/models folder alone is insufficient. "
                      "Find the validation-selected checkpoint and its native audit "
                      "manifest on the host and make them available to this job, "
                      "or train maintenance-rul-controlled-fd003-patchformer-s42 first."
                  )
              payload = json.loads(audit.read_text(encoding="utf-8"))
              best = payload.get("best_model_path")
              checkpoint = Path(best).expanduser().resolve() if isinstance(best, str) and best else None
              if checkpoint is None or checkpoint.parent.name != run or not checkpoint.is_file():
                  raise SystemExit(
                      f"Invalid upstream best_model_path={best!r} in {audit}. "
                      "Its path must resolve inside the pod, and the checkpoint "
                      f"must belong to the exact upstream run {run}."
                  )
              if not endpoint.is_file():
                  raise SystemExit(
                      f"Missing train-only endpoint normalizer: {endpoint}. "
                      "Prepare the matching FD003 seed-42 endpoint artifact "
                      "before the six-factor comparison."
                  )
              print(f"Validated upstream checkpoint: {checkpoint}", flush=True)
              print(f"Validated upstream endpoint artifact: {endpoint}", flush=True)
              PY
              # Build the runtime environment per Pod; never use the image's
              # editable /env installation or persist a venv on JuiceFS.
              uv venv "$UV_PROJECT_ENVIRONMENT" --python 3.13
              uv sync --locked --no-dev --all-packages --all-extras
              "$UV_PROJECT_ENVIRONMENT/bin/python" - <<'PY'
              import nexuml
              import nexuml_library
              import torch
              print("NEX-233 source:", nexuml.__file__, flush=True)
              print("NEX-233 library:", nexuml_library.__file__, flush=True)
              if not torch.cuda.is_available():
                  raise SystemExit("CUDA device unavailable to RUL job")
              print("CUDA:", torch.cuda.get_device_name(0), flush=True)
              PY
              "$UV_PROJECT_ENVIRONMENT/bin/nexuml" resolve \
                __SCENARIO__ \
                --output .experiments/rul/enhanced-cfc/fd003/compare-six-s__SEED__.yaml
              "$UV_PROJECT_ENVIRONMENT/bin/nexuml" train \
                --config .experiments/rul/enhanced-cfc/fd003/compare-six-s__SEED__.yaml
          resources:
            requests:
              nvidia.com/gpu: "1"
            limits:
              nvidia.com/gpu: "1"
          volumeMounts:
            - name: juicefs
              mountPath: /mnt/nexuml-source
              subPath: __STAGE_SUBPATH__
              readOnly: true
            - name: juicefs
              mountPath: /mnt/nexuml-experiments
              subPath: code/nexuml/.experiments
            - name: juicefs
              mountPath: /mnt/nexuml-data
              subPath: code/nexuml/data
            - name: juicefs-prisma
              mountPath: /mnt/data
              subPath: data
            - name: juicefs-prisma
              mountPath: /mnt/logs
              subPath: logs
            - name: juicefs-prisma
              mountPath: /mnt/models
              subPath: models
            - name: runtime-venv
              mountPath: /tmp/nexuml-job-venv
            - name: shared-mem
              mountPath: /dev/shm
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: nvidia.com/cuda.runtime.major
                    operator: Gt
                    values: ["11"]
